<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="es.jmcenram.blockchain.controller.ConfiguracionController"
           stylesheets="@/css/dark.css"
           style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <VBox spacing="20"
          alignment="TOP_CENTER"
          style="-fx-padding: 30;">

        <!-- HEADER -->
        <HBox spacing="10" alignment="CENTER_LEFT">

            <Button onAction="#volver"
                    styleClass="btn-secondary">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-left"/>
                </graphic>
            </Button>

            <Label text="%blockchain_configuration"
                   styleClass="title"/>
        </HBox>

        <!-- CARD -->
        <VBox spacing="15"
              maxWidth="420"
              styleClass="card">

            <!-- RPC -->
            <Label text="%rpc_url" styleClass="lbl-muted"/>

            <TextField fx:id="rpcUrlField"
                       promptText="%default_rpc"
                       prefHeight="36"
                       styleClass="input"/>

            <!-- CONTRACT -->
            <Label text="%contract_address" styleClass="lbl-muted"/>

            <TextField fx:id="contractAddressField"
                       prefHeight="36"
                       promptText="%autofill_connect"
                       styleClass="input"/>

            <!-- RUTA -->
            <Label text="%config_file" styleClass="lbl-muted"/>

            <TextField fx:id="rutaConfigField"
                       editable="false"
                       prefHeight="36"
                       promptText="%not_selected"
                       styleClass="input"/>

            <!-- BOTONES -->
            <HBox spacing="10" alignment="CENTER_RIGHT">

                <!-- CARGAR -->
                <Button text="%load_config"
                        onAction="#cargarConfig"
                        styleClass="btn-secondary">
                    <graphic>
                        <FontIcon iconLiteral="fas-folder-open"/>
                    </graphic>
                </Button>

                <!-- GUARDAR -->
                <Button text="%save_config"
                        onAction="#guardar"
                        styleClass="btn-secondary">
                    <graphic>
                        <FontIcon iconLiteral="fas-save"/>
                    </graphic>
                </Button>

                <!-- CONECTAR -->
                <Button text="%connect"
                        onAction="#conectar"
                        styleClass="btn-primary">
                    <graphic>
                        <FontIcon iconLiteral="fas-link"/>
                    </graphic>
                </Button>

            </HBox>

            <!-- ESTADO -->
            <Label fx:id="lblEstado"
                   wrapText="true"
                   text="%status_not_connected"
                   styleClass="lbl-muted"/>

        </VBox>

    </VBox>

</StackPane>