<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="es.jmcenram.blockchain.controller.login.LoginController"
           stylesheets="@/css/dark.css"
           prefWidth="600" prefHeight="450"
           style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <VBox alignment="CENTER"
          spacing="18"
          prefWidth="420" prefHeight="420"
          maxWidth="420" maxHeight="420"
          styleClass="card"
          pickOnBounds="false">

        <!-- LOGO -->
        <StackPane prefWidth="110" prefHeight="110"
                   minWidth="110" minHeight="110"
                   maxWidth="110" maxHeight="110"
                   styleClass="logo-container">

            <ImageView fitWidth="78" fitHeight="78"
                       preserveRatio="true"
                       style="-fx-opacity: 0.95;">
                <image>
                    <Image url="/img/icono-reverse.png"/>
                </image>
            </ImageView>

        </StackPane>

        <!-- TÍTULO -->
        <Label text="%welcome" styleClass="title"/>

        <!-- SUBTÍTULO -->
        <Label text="%access_system"
               styleClass="subtitle"/>

        <!-- EMAIL -->
        <HBox fx:id="hboxEmail"
              alignment="CENTER_LEFT"
              spacing="10"
              prefHeight="42"
              styleClass="input"
        >

            <FontIcon iconLiteral="mdi2e-email-outline"
                      styleClass="ikonli-font-icon"/>

            <TextField fx:id="txtEmail"
                       promptText="%user"
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color: transparent; -fx-text-fill: white;"/>

        </HBox>

        <!-- PASSWORD -->
        <HBox alignment="CENTER_LEFT"
              spacing="10"
              prefHeight="42"
              styleClass="input">

            <FontIcon iconLiteral="mdi2l-lock-outline"
                      styleClass="ikonli-font-icon"/>

            <PasswordField fx:id="txtPassword"
                           promptText="%password"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-text-fill: white;"/>

        </HBox>

        <!-- PASSWORD NUEVA -->
        <PasswordField fx:id="txtPasswordNueva"
                       promptText="%new_password"
                       visible="false"
                       managed="false"
                       prefHeight="42"
                       styleClass="input"/>

        <!-- BOTÓN LOGIN -->
        <Button text="%login"
                prefWidth="260"
                prefHeight="44"
                onAction="#login"
                styleClass="btn-primary"/>

        <!-- SEPARADOR -->
        <HBox fx:id="hboxSeparador"
              alignment="CENTER"
              spacing="10"
              prefWidth="260">

            <Separator HBox.hgrow="ALWAYS"/>
            <Label text="o" styleClass="lbl-muted"/>
            <Separator HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- CREAR CUENTA -->
        <Button fx:id="btnCrearCuenta"
                text="%create_account"
                prefWidth="260"
                prefHeight="40"
                onAction="#irARegistro"
                styleClass="btn-secondary"/>

    </VBox>

    <!-- COMBO IDIOMA — encima del VBox -->
    <HBox alignment="TOP_RIGHT"
          spacing="10"
          StackPane.alignment="TOP_RIGHT"
          style="-fx-padding: 10;"
          pickOnBounds="false">

        <ComboBox fx:id="comboIdioma"
                  prefWidth="140"
                  onAction="#cambiarIdioma"/>

    </HBox>

    <!-- BOTÓN QR -->
    <HBox alignment="TOP_LEFT"
          spacing="10"
          StackPane.alignment="TOP_LEFT"
          style="-fx-padding: 10;"
          pickOnBounds="false">

        <Button onAction="#irAQr"
                styleClass="btn-secondary">

            <graphic>
                <FontIcon iconLiteral="fas-qrcode"/>
            </graphic>
            <tooltip>
                <Tooltip text="%verify_qr"/>
            </tooltip>

        </Button>

    </HBox>

</StackPane>