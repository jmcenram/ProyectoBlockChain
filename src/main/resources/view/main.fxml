<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>


<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="es.jmcenram.blockchain.controller.MainController"
            stylesheets="@/css/dark.css"
            style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <top>
        <HBox alignment="CENTER_RIGHT"
              spacing="12"
              styleClass="top-bar"
              style="-fx-padding: 12 20;">

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="%user_label" styleClass="lbl-muted"/>
            <Label fx:id="lblUsuario" styleClass="lbl-user"/>

            <!-- NUEVO -->
            <Label fx:id="lblEntidad" text="%entity_label" styleClass="lbl-muted"/>
            <Label fx:id="lblEntidadNombre" styleClass="lbl-user"/>

            <Button text="%my_profile"
                    onAction="#irAMiPerfil"
                    styleClass="btn-secondary"/>

            <Button text="%logout"
                    onAction="#logout"
                    styleClass="btn-secondary"/>
        </HBox>
    </top>

    <center>
        <StackPane alignment="CENTER">

            <!-- TARJETA -->
            <VBox alignment="CENTER"
                  spacing="22"
                  prefWidth="420"
                  prefHeight="420"
                  maxWidth="420"
                  maxHeight="420"
                  styleClass="card">

                <!-- TÍTULO -->
                <Label text="%blockchain_system"
                       styleClass="title"/>

                <!-- SUBTÍTULO -->
                <Label text="%management_validation"
                       styleClass="subtitle"/>

                <!-- ESPACIADOR -->
                <Region prefHeight="10"/>

                <!-- BOTONES -->
                <VBox spacing="15" alignment="CENTER">

                    <Button prefWidth="260"
                            prefHeight="45"
                            onAction="#irADocumentos"
                            styleClass="btn-primary"
                            text="%document_management">

                        <graphic>
                            <FontIcon iconLiteral="fas-file"/>
                        </graphic>
                    </Button>

                    <Button fx:id="btnConfiguracion"
                            prefWidth="260"
                            prefHeight="45"
                            onAction="#irAConfiguracion"
                            styleClass="btn-secondary"
                            text="%blockchain_config">

                        <graphic>
                            <FontIcon iconLiteral="fas-cog"/>
                        </graphic>
                    </Button>

                    <Button fx:id="btnRegistrar"
                            prefWidth="260"
                            prefHeight="45"
                            onAction="#irARegistroUsuario"
                            styleClass="btn-secondary"
                            text="%register_user">

                        <graphic>
                            <FontIcon iconLiteral="fas-user"/>
                        </graphic>
                    </Button>

                    <Button fx:id="btnEntidadesEmisoras"
                            prefWidth="260"
                            prefHeight="45"
                            onAction="#irAEntidadesEmisoras"
                            styleClass="btn-secondary"
                            text="%entity_management">

                        <graphic>
                            <FontIcon iconLiteral="fas-building"/>
                        </graphic>
                    </Button>

                </VBox>

            </VBox>

        </StackPane>
    </center>

</BorderPane>
