<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="root"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="es.jmcenram.blockchain.controller.DocumentoController"
           stylesheets="@/css/dark.css"
           style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <!-- CONTENIDO -->
    <VBox spacing="15" alignment="TOP_CENTER"
          style="-fx-padding: 20;">

        <!-- HEADER -->
        <HBox spacing="10" alignment="CENTER_LEFT">

            <Button onAction="#volver"
                    styleClass="btn-secondary">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-left"/>
                </graphic>
            </Button>

            <Label text="%document_management_title"
                   styleClass="title"/>
        </HBox>

        <!-- ACCIONES -->
        <HBox spacing="10" alignment="CENTER_LEFT">

            <TextField fx:id="txtNombre"
                       promptText="%document_name"
                       prefWidth="240"
                       editable="false"
                       styleClass="input"/>

            <Button
                    onAction="#subirArchivo"
                    styleClass="btn-secondary">
                <graphic>
                    <FontIcon iconLiteral="fas-folder-open"/>
                </graphic>

            </Button>

            <Button text="%create"
                    onAction="#crearDocumento"
                    styleClass="btn-primary"/>

            <Separator orientation="VERTICAL"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="%filters"
                    onAction="#toggleFiltros"
                    styleClass="btn-secondary"/>

            <MenuButton fx:id="btnColumnas"
                        text="%columns"
                        styleClass="btn-secondary"/>

        </HBox>

        <!-- TABLA -->
        <TableView fx:id="tablaDocumentos"
                   VBox.vgrow="ALWAYS"
                   styleClass="table-view">

            <columns>
                <TableColumn fx:id="colNombre" text="%name" prefWidth="150"/>
                <TableColumn fx:id="colFecha" text="%date" prefWidth="140"/>
                <TableColumn fx:id="colEstado" text="%status" prefWidth="110"/>
                <TableColumn fx:id="colEstadoRegistro" text="%blockchain" prefWidth="140"/>
                <TableColumn fx:id="colFechaRegistro" text="%blockchain_date" prefWidth="150"/>
                <TableColumn fx:id="colHash" text="%hash" prefWidth="200"/>
                <TableColumn fx:id="colRuta" text="%path" prefWidth="220"/>
                <TableColumn fx:id="colAcciones" text="%actions" prefWidth="270"/>
            </columns>

        </TableView>

    </VBox>

    <!-- OVERLAY -->
    <VBox fx:id="loadingOverlay"
          alignment="CENTER"
          spacing="15"
          visible="false"
          styleClass="overlay">

        <ProgressIndicator prefWidth="80" prefHeight="80"/>

        <Label fx:id="lblLoading"
               text="%processing"
               styleClass="loading-text"/>
    </VBox>

    <VBox fx:id="panelFiltros"
          visible="false"
          managed="false"

          prefWidth="280"
          minWidth="280"
          maxWidth="280"

          prefHeight="400"
          minHeight="400"
          maxHeight="400"

          spacing="0"
          styleClass="panel-filtros"
          StackPane.alignment="TOP_RIGHT">

        <StackPane.margin>
            <Insets top="70" right="20"/>
        </StackPane.margin>

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT"
              style="-fx-padding: 0 0 10 0;">
            <Label text="%filters" styleClass="title-small"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✖"
                    onAction="#toggleFiltros"
                    styleClass="btn-icon"/>
        </HBox>

        <Separator/>

        <!-- CONTENIDO FLEX -->
        <VBox spacing="10"
              VBox.vgrow="ALWAYS"
              style="-fx-padding: 10 0;">

            <Label text="%name" styleClass="label"/>
            <TextField fx:id="filtroNombre"
                       prefHeight="34"
                       maxWidth="Infinity"
                       styleClass="input"/>

            <Label text="%date" styleClass="label"/>
            <DatePicker fx:id="filtroFecha"
                        prefHeight="34"
                        maxWidth="Infinity"/>

            <Label text="%status" styleClass="label"/>
            <ComboBox fx:id="filtroEstado"
                      prefHeight="34"
                      maxWidth="Infinity"
                      styleClass="input"/>

            <Label text="%blockchain_status" styleClass="label"/>
            <ComboBox fx:id="filtroEstadoBlockchain"
                      prefHeight="34"
                      maxWidth="Infinity"
                      styleClass="input"/>

        </VBox>

        <Separator/>

        <!-- FOOTER FIJO -->
        <HBox spacing="10"
              alignment="CENTER_RIGHT"
              style="-fx-padding: 10 0 0 0;">

            <Button text="%clear"
                    onAction="#limpiarFiltros"
                    styleClass="btn-secondary"/>

            <Button text="%apply"
                    onAction="#aplicarFiltros"
                    styleClass="btn-success"/>
        </HBox>

    </VBox>

</StackPane>