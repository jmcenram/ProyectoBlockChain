<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">

    <persistence-unit name="blockchainPU" transaction-type="RESOURCE_LOCAL">
        <class>es.jmcenram.blockchain.config.SQLiteLocalDateTimeConverter</class>
        <class>es.jmcenram.blockchain.model.auditoria.Auditoria</class>
        <class>es.jmcenram.blockchain.model.documento.Documento</class>
        <class>es.jmcenram.blockchain.model.entidademisora.EntidadEmisora</class>
        <class>es.jmcenram.blockchain.model.registroblockchain.RegistroBlockchain</class>
        <class>es.jmcenram.blockchain.model.rol.Rol</class>
        <class>es.jmcenram.blockchain.model.usuario.Usuario</class>
        <class>es.jmcenram.blockchain.model.usuariorol.UsuarioRol</class>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <property name="hibernate.connection.provider_class"
                      value="es.jmcenram.blockchain.connection.SQLiteConnectionProvider"/>
            <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
